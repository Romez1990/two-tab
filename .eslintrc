{
  "env": {
    "browser": true,
    "webextensions": true,
    "jest": true
  },
  "extends": [
    "airbnb",
    "prettier",
    "prettier/react"
  ],
  "plugins": [
    "import",
    "prettier",
    "react",
    "react-hooks",
    "jsx-a11y"
  ],
  "rules": {
    "prettier/prettier": "error",
    "no-unused-vars": [
      "warn",
      {
        "vars": "local",
        "args": "all",
        "ignoreRestSiblings": true,
        "caughtErrors": "all"
      }
    ],
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": true,
        "peerDependencies": true
      }
    ],
    "no-use-before-define": "off",
    "class-methods-use-this": "off",
    "import/prefer-default-export": "off",
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never"
      }
    ],
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [
          ".jsx",
          ".tsx"
        ]
      }
    ],
    "react/jsx-fragments": [
      "error",
      "element"
    ],
    "react/prop-types": "off"
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx",
          ".json"
        ]
      }
    },
    "import/extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ]
  },
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "extends": [
        "plugin:@typescript-eslint/recommended",
        "prettier/@typescript-eslint"
      ],
      "plugins": [
        "@typescript-eslint"
      ],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": [
          "warn",
          {
            "vars": "local",
            "args": "all",
            "ignoreRestSiblings": true,
            "caughtErrors": "all"
          }
        ],
        "@typescript-eslint/explicit-member-accessibility": "warn"
      }
    },
    {
      "files": [
        "config/**/*",
        "scripts/**/*"
      ],
      "rules": {
        "strict": "off"
      }
    },
    {
      "files": [
        "scripts/**/*"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
