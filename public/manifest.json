{
  "name": "Two Tab",
  "version": "1.0.0",
  "description": "Tab grouper with ability to sync tabs across devices",
  "manifest_version": 2,
  "permissions": [
    "tabs"
  ],
  "background": {
    "page": "background.html",
    "persistent": false
  },
  "browser_action": {
    "default_title": "Two Tab",
    "default_popup": "popup.html"
  }
}
